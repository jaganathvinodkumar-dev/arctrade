<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArcTrade | Portfolio</title>
  <link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/responsive.css">
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <style>
     html,body{margin:0;padding:0;font-family:Inter, Arial, sans-serif;background:var(--bg,#f5f7fb);color:var(--text,#1f2937)}
     .navbar{display:flex;align-items:center;justify-content:space-between;padding:14px}
     .portfolio-hero{padding:20px 0}
   </style>
</head>
<body>
  <header class="navbar">
    <div class="brand"><a href="index.html">ArcTrade</a></div>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">☰</button>
    <nav class="nav-menu" id="nav-menu">
      <a href="index.html">Home</a>
      <a href="markets.html">Markets</a>
      <a href="stock.html">Stock</a>
      <a href="portfolio.html">Portfolio</a>
      <a href="watchlist.html">Watchlist</a>
      <a href="contact.html">Contact</a>
    </nav>
    <button class="theme-toggle" id="theme-btn">🌙</button>
  </header>

  <main>
    <section class="portfolio-hero">
      <span class="eyebrow">Portfolio</span>
      <h1>Total Portfolio Value</h1>
      <p class="portfolio-value">₹262,400</p>
      <div class="portfolio-cards">
        <div class="mini-card">
          <h4>Profit / Loss</h4>
          <p class="up">+₹14,600</p>
        </div>
        <div class="mini-card">
          <h4>Monthly Return</h4>
          <p>+4.5%</p>
        </div>
        <div class="mini-card">
          <h4>Invested</h4>
          <p>₹247,800</p>
        </div>
      </div>
    </section>

    <section class="holdings-section">
      <div class="section-heading">
        <span class="eyebrow">Holdings</span>
        <h2>Your current positions</h2>
      </div>
      <div class="holdings-table">
        <div class="table-row table-header">
          <span>Company</span>
          <span>Shares</span>
          <span>Value</span>
          <span>P/L</span>
        </div>
        <div class="table-row">
          <span>Reliance</span>
          <span>56</span>
          <span>₹162,400</span>
          <span class="up">+₹8,500</span>
        </div>
        <div class="table-row">
          <span>TCS</span>
          <span>22</span>
          <span>₹84,700</span>
          <span class="up">+₹4,100</span>
        </div>
        <div class="table-row">
          <span>Infosys</span>
          <span>24</span>
          <span>₹15,300</span>
          <span class="down">-₹1,500</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div><h3>ArcTrade</h3><p>Monitor your investments with clear performance metrics.</p></div>
    <div class="footer-links"><a href="watchlist.html">Watchlist</a><a href="contact.html">Contact</a></div>
  </footer>

  <script src="../js/theme.js"></script>
  <script src="../js/app.js"></script>
</body>
</html>
