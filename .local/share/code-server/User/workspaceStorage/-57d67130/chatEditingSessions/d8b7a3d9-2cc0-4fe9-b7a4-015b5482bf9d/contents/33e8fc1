<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArcTrade | Watchlist</title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/responsive.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style>
    html,body{margin:0;padding:0;font-family:Inter, Arial, sans-serif;background:var(--bg,#f5f7fb);color:var(--text,#1f2937)}
    .navbar{display:flex;align-items:center;justify-content:space-between;padding:14px}
    .watchlist-controls{display:flex;gap:12px}
  </style>
</head>
<body>
  <header class="navbar">
    <div class="brand"><a href="index.html">ArcTrade</a></div>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">☰</button>
    <nav class="nav-menu" id="nav-menu">
      <a href="index.html">Home</a>
      <a href="markets.html">Markets</a>
      <a href="stock.html">Stock</a>
      <a href="portfolio.html">Portfolio</a>
      <a href="watchlist.html">Watchlist</a>
      <a href="contact.html">Contact</a>
    </nav>
    <button class="theme-toggle" id="theme-btn">🌙</button>
  </header>

  <main>
    <section class="page-intro">
      <div>
        <span class="eyebrow">Watchlist</span>
        <h1>Track stocks you care about.</h1>
        <p>Search, add, and remove stocks from your watchlist instantly.</p>
      </div>
      <div class="watchlist-controls">
        <input type="search" id="watchlist-search" placeholder="Filter your watchlist...">
        <button class="btn btn-primary" id="watchlist-add-btn">Add Stock</button>
      </div>
    </section>

    <section class="watchlist-section">
      <div class="watchlist-grid" id="watchlist-cards"></div>
    </section>
  </main>

  <footer class="site-footer">
    <div><h3>ArcTrade</h3><p>Manage the stocks you follow with ease.</p></div>
    <div class="footer-links"><a href="markets.html">Markets</a><a href="portfolio.html">Portfolio</a></div>
  </footer>

  <script src="../js/theme.js"></script>
  <script src="../js/app.js"></script>
</body>
</html>
