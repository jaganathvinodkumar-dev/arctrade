@media (max-width: 768px) {
  .hero-section,
  .stock-hero,
  .portfolio-hero,
  .contact-hero,
  .page-intro {
    grid-template-columns: 1fr;
  }

  .info-grid,
  .feature-grid,
  .testimonial-grid,
  .index-grid,
  .trending-grid,
  .portfolio-cards,
  .stock-detail-cards,
  .watchlist-grid,
  .market-sections,
  .form-row {
    grid-template-columns: 1fr;
  }

  .nav-menu {
    width: 100%;
  }
}

@media (max-width: 1024px) {
  .hero-section,
  .stock-hero,
  .portfolio-hero,
  .contact-hero,
  .page-intro {
    gap: 24px;
  }
}

@media (max-width: 1440px) {
  .navbar,
  .main,
  footer {
    width: min(100%, calc(100% - 32px));
  }
}
