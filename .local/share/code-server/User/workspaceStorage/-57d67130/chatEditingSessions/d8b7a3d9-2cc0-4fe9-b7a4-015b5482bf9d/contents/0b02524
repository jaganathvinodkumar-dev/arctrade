<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArcTrade | Stock Details</title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/responsive.css">
</head>
<body>
  <header class="navbar">
    <div class="brand"><a href="index.html">ArcTrade</a></div>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">☰</button>
    <nav class="nav-menu" id="nav-menu">
      <a href="index.html">Home</a>
      <a href="markets.html">Markets</a>
      <a href="stock.html">Stock</a>
      <a href="portfolio.html">Portfolio</a>
      <a href="watchlist.html">Watchlist</a>
      <a href="contact.html">Contact</a>
    </nav>
    <button class="theme-toggle" id="theme-btn">🌙</button>
  </header>

  <main>
    <section class="stock-hero">
      <div>
        <span class="eyebrow">Stock Details</span>
        <h1>Reliance Industries</h1>
        <p>₹2900 <span class="tag up">+2.5%</span></p>
        <p class="stock-description">Reliance Industries is a diversified conglomerate with leadership across energy, retail, telecom, and digital services.</p>
        <div class="cta-group">
          <button class="btn btn-primary">Buy</button>
          <button class="btn btn-secondary">Sell</button>
        </div>
      </div>
      <div class="stock-summary-card">
        <h3>Market Statistics</h3>
        <ul>
          <li><strong>Open:</strong> ₹2865</li>
          <li><strong>High:</strong> ₹2915</li>
          <li><strong>Low:</strong> ₹2840</li>
          <li><strong>Volume:</strong> 1.32M</li>
          <li><strong>Market Cap:</strong> ₹16.5T</li>
        </ul>
      </div>
    </section>

    <section class="stock-detail-cards">
      <div class="detail-card">
        <h4>Sector</h4>
        <p>Energy</p>
      </div>
      <div class="detail-card">
        <h4>P/E Ratio</h4>
        <p>28.4</p>
      </div>
      <div class="detail-card">
        <h4>Dividend Yield</h4>
        <p>0.58%</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div><h3>ArcTrade</h3><p>Track your favorite stocks with confidence.</p></div>
    <div class="footer-links"><a href="markets.html">Markets</a><a href="contact.html">Contact</a></div>
  </footer>

  <script src="../js/theme.js"></script>
  <script src="../js/app.js"></script>
</body>
</html>
